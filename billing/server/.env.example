# billing/server/.env.example
#
# Copy to .env and fill in. NEVER commit the real .env.
#
# All credentials below are local-dev placeholders.  For production, use
# the deployment guide in DEPLOY.md and source secrets from HashiCorp Vault
# or AWS Secrets Manager.

# --- Required for the LiteLLM bridge ---
LITELLM_BASE_URL=http://localhost:4000
LITELLM_MASTER_KEY=sk-litellm-master-CHANGE-ME

# --- Database / Redis (matches docker-compose.yml) ---
DATABASE_URL=postgresql://autumn:autumn_dev_only@localhost:5433/autumn
DATABASE_URL_CRITICAL=postgresql://autumn:autumn_dev_only@localhost:5433/autumn
READ_REPLICA_URL=postgresql://autumn:autumn_dev_only@localhost:5433/autumn
REDIS_URL=redis://:autumn_dev_only@localhost:6380
# Misc cache — required at boot (initUtils.ts exits without it).
# Locally this can be the same Redis instance as REDIS_URL.
MISC_CACHE_DRAGONFLY_PUBLIC_URL=redis://:autumn_dev_only@localhost:6380

# --- Secrets manager (Infisical in dev, Vault in prod) ---
INFISICAL_PROJECT_ID=
INFISICAL_ENVIRONMENT=dev

# --- Encryption password for customer keys at rest (32+ bytes) ---
ENCRYPTION_PASSWORD=change-me-to-a-random-32-byte-secret
# --- 16-byte hex IV for processor credential encryption (required at boot) ---
# generate: openssl rand -hex 16
ENCRYPTION_IV=change-me-to-16-random-hex-bytes

# --- Better-Auth ---
BETTER_AUTH_SECRET=change-me-to-a-random-secret
BETTER_AUTH_URL=http://localhost:8080

# --- Sign-in (Google OAuth + email OTP) ---
# The demo does not use real Google. demo/mock_cloud.py serves a fake consent
# chooser on :9998 (any email works, no password) and a fake inbox at
# /inbox for the OTP emails. EMULATE_GOOGLE_URL is what redirects the browser
# there instead of accounts.google.com.
GOOGLE_CLIENT_ID=mock-google-client
GOOGLE_CLIENT_SECRET=mock-google-secret
EMULATE_GOOGLE_URL=http://localhost:9998
# OTP delivery. The mock inbox captures whatever Resend would have sent.
RESEND_API_KEY=mock-resend-key
RESEND_DOMAIN=meterpal.dev
RESEND_BASE_URL=http://localhost:9998
# CAPY_DEV=1 turns off Capy (the hosted auth widget) so the local dashboard
# uses better-auth's own forms. Required for the local stack.
CAPY_DEV=1

# --- MeterPal API key (the server's own credential) ---
# Minted by `python demo/bootstrap.py`, which writes the plaintext here and
# stores only its SHA-256 in api_keys. The dashboard's server-side calls use
# it; without it those calls 401. Sandbox keys start with am_sk_test_.
AUTUMN_SECRET_KEY=am_sk_test_REPLACE_ME

# --- First-run claim (demo/bootstrap.py --admin) ---
# The first dashboard sign-in whose email matches claims this org as owner
# instead of being given an empty one. Leave unset in production.
# METERPAL_FIRST_RUN_ORG=org_demo
# METERPAL_FIRST_RUN_EMAIL=you@example.com

# --- Observability (optional) ---
SENTRY_DSN=
LOGTAIL_TOKEN=
AXIOM_TOKEN=

# --- PayPal (sandbox while developing; set PAYPAL_ENV=live for prod) ---
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=REPLACE_ME
PAYPAL_CLIENT_SECRET=REPLACE_ME
# PayPal Product (catalog) id that subscriptions are created under.
PAYPAL_PRODUCT_ID=MeterPal1098
# Webhook ID from the sandbox app's webhook subscription pointing at
# <public-url>/webhooks/paypal. `python demo/bootstrap.py` fills this in when
# PAYPAL_WEBHOOK_URL is set; left unset, PayPal cannot reach localhost and the
# demo app credits approved orders from its own capture poll instead.
PAYPAL_WEBHOOK_ID=REPLACE_ME
# Public URL PayPal should POST to (a tunnel in development). bootstrap.py
# registers it and writes the id above.
# PAYPAL_WEBHOOK_URL=https://<tunnel>/webhooks/paypal
# Optional: cache dir for verified PayPal signing certs
PAYPAL_CERT_CACHE_DIR=./.cache/paypal-certs
# Credit feature that PayPal money-in funds (1 credit = 1 USD)
METERPAL_CREDIT_FEATURE_ID=ai_tokens
# App page the buyer lands on after the server captures their payment
# METERPAL_CHECKOUT_RETURN_URL=https://app.yourdomain.com
# Public base URL of THIS server (PayPal browser redirects; for local dev the
# browser and server share the machine, so localhost works without a tunnel)
# METERPAL_PUBLIC_URL=https://billing.yourdomain.com

# --- Usage Studio assistant ---
# The model the dashboard's assistant runs on when a request names none.
# It must be a model the org actually sells: the studio reads the org's price
# sheet and this only picks which row it prefers.
#
# Defaults to the mock on purpose. The studio beat is a scripted agent chain
# (demo/mock_agent.py), so the mock is deterministic and cannot rate-limit
# itself mid-take. A real free-tier model (`custom/agnes-2.5-flash`, which
# demo/bootstrap.py seeds as "Agnes 2.5 Flash (real)") answers the same beat
# more convincingly right up until its quota runs out -- which shows up as a
# 429 in the assistant panel halfway through the recording.
STUDIO_DEFAULT_MODEL=custom/demo-gpt

# --- Server ---
PORT=8080
NODE_ENV=development
# Dependency failure policy: what optional infrastructure (idempotency store,
# distributed rate limiting, cache-backed reads) does when it is unavailable.
#   fail_open (default) — keep serving: bypass the guard, answer the hot path.
#   fail_closed — shed with 503 instead of serving without the guard.
# Queue/worker concurrency caps always fail open (throughput, not correctness).
DEP_FAILURE_POLICY=fail_open
# Serving fork count per task. The primary pins its resolved value into each
# child's env at fork time (see init.ts); set manually only for standalone
# prod processes that must share a cluster-wide cap budget.
# SERVER_FLEET_SIZE=4
# Required by @autumn/env — the server refuses to boot without both.
AUTUMN_API_URL=http://localhost:8080
AUTUMN_PUBLIC_API_URL=http://localhost:8080
# Redis v2 (full-subject/feature cache). Without it the pool defaults to
# 127.0.0.1:6379 and customer reads shed with 503 cache_unavailable.
CACHE_V2_DRAGONFLY_URL=redis://:autumn_dev_only@localhost:6380

# --- Tests (bun test) ---
# Org the integration tests seed into. Must be the org the API key above
# belongs to, or the fixtures land in a different tenant and every assertion
# about balances fails.
# TESTS_ORG_ID=org_demo
