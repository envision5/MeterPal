VITE_FRONTEND_URL=http://localhost:3000
VITE_BACKEND_URL=http://localhost:8080

# Google OAuth button on the sign-in screen. Only enable this when the
# billing server has GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET configured.
# The local demo uses mock credentials, so this is ON by default.
VITE_ENABLE_GOOGLE_SIGNIN=1

# Route the emulated Google authorization page through the vite proxy
# (same-origin /o/oauth2 -> demo/mock_cloud.py on :9998). Without it the
# button sends the browser to accounts.google.com and sign-in dead-ends.
VITE_EMULATE_GOOGLE_PROXY=1
