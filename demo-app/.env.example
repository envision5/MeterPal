# demo-app/.env.example
#
# You normally do not write this file by hand: `python demo/bootstrap.py`
# generates demo-app/.env.local (and .binding.json) from the org it seeds, so
# the storefront, the wallet and the dashboard all describe the same tenant.
# This file documents what that binding contains.
#
# Copy to .env.local only if you want to point the storefront at an org you
# bound yourself with `python demo/bind.py --org <id>`.

# Billing API the storefront calls for plans, balances and checkout.
METERPAL_API_URL=http://localhost:8080
# Sandbox secret key for the bound org (am_sk_test_...). Written by bootstrap.
METERPAL_SECRET_KEY=am_sk_test_REPLACE_ME
# Org the storefront bills. Must match the key's org or every call 401s.
METERPAL_ORG_ID=org_demo
# The AI-credit feature whose balance the wallet pill shows.
METERPAL_FEATURE_ID=ai_tokens

# Model the demo chat calls through the gateway.
DEMO_MODEL_ID=custom/demo-gpt
# Personas in the customer switcher (comma separated customer ids).
DEMO_CUSTOMER_IDS=demo-customer-1,demo-customer-2
# Top-up products offered in the modal (comma separated plan ids). Left unset,
# the server lists every add-on plan that is not a usage package.
# DEMO_TOPUP_PRODUCT_IDS=topup-10,topup-50,topup-200

# The sandbox BUYER account that approves payments. Approval is deliberately
# manual — the agent can open a PayPal checkout but never approve one — and the
# paywall card names this account so the click is not guesswork.
# DEMO_PAYPAL_BUYER=sb-buyer@personal.example.com
