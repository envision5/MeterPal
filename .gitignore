# dependencies / builds
node_modules/
dist/
build/

# The TypeScript SDK's build output IS committed: package.json points main/bin
# at dist/, so a judge who clones this repo must be able to `bun add file:...`
# or `bunx meterpal init` without running a build first. There is deliberately
# no `prepare` script — a consumer installing this package from a path does not
# get its devDependencies, so a lifecycle build would fail for them. Rebuild
# with `bun run build` in sdk/typescript after changing src/.
!sdk/typescript/dist/
!sdk/typescript/dist/**
.verify-out/
*.tsbuildinfo

# python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# env & secrets — never commit
.env
.env.*
!.env.example

# generated by demo/bind.py — describes THIS machine's binding, not the repo
demo-app/.binding.json

# caches & runtime state
.cache/
*.log
# Only the stack's own log directory, which is root-relative. A bare `logs/`
# also matches SOURCE directories called `logs/` -- the billing server has four
# of them (`.../licenses/actions/logs`, `.../billing/v2/utils/logs`, ...) and
# they were being kept out of the repo while the committed code imported them,
# so a fresh clone could not typecheck.
/logs/
/demo/logs/
# A Next.js static export, not source: regenerated by the gateway's build.
/gateway/litellm/proxy/_experimental/out/
.DS_Store
Thumbs.db

# tooling
.idea/
.vscode/*
!.vscode/extensions.json

# Session/local artifacts -- never commit credentials or probe state
demo/*cookies*
demo/probe_key.json
*.session_token

# Submission bundles are rebuilt at submission time, never tracked
# (a bundle captures .env files -- keep it out of git entirely)
MeterPal*.zip

# Local agent / IDE session artifacts -- never part of the project
.workbuddy-ai/
.zcode/

# Research working material -- competitor repos, harvested READMEs and source
# trees.  Local scratch only: it is other people's code and must never ship
# in the submission repository.  Anchored to the repo root so the brief the
# docs cite (docs/research/) is unaffected.
/research/

# GUI test-run screenshots (untracked capture artifacts)
gui-test-screenshots/

# Browser-automation session cache
.playwright-cli/

# Accessibility-tree dump captured while debugging the demo UI
home.yaml

# One-off repair script kept while migrating the demo app
demo-app/.tmp-repair.py

# Video footage captured for the submission video (lives in YouTube, not git)
demo-video-footage/
# Stills and b-roll prepared for the same video. Local media only -- it is
# never part of the product, and the judge's own upload instruction is
# `git add -A`, which would otherwise sweep 9 MB of images into the repo.
# Ignored rather than deleted so it can be used and then removed by hand.
prepared-media/

# Ad-hoc UI screenshots taken while building the offer flow
ui-*.png

# Windows shell redirect artifact ("... > nul" in a POSIX-style shell)
demo-app/nul
nul
