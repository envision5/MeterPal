# dependencies / builds
node_modules/
dist/
build/
.verify-out/
*.tsbuildinfo

# python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# env & secrets — never commit
.env
.env.*
!.env.example

# caches & runtime state
.cache/
*.log
logs/
.DS_Store
Thumbs.db

# tooling
.idea/
.vscode/*
!.vscode/extensions.json

# Session/local artifacts -- never commit credentials or probe state
demo/*cookies*
demo/probe_key.json
*.session_token

# Submission bundles are rebuilt at submission time, never tracked
# (a bundle captures .env files -- keep it out of git entirely)
MeterPal*.zip

# Local agent / IDE session artifacts -- never part of the project
.workbuddy-ai/
.zcode/

# Research working material -- competitor repos, harvested READMEs and source
# trees.  Local scratch only: it is other people's code and must never ship
# in the submission repository.  Anchored to the repo root so the brief the
# docs cite (docs/research/) is unaffected.
/research/

# GUI test-run screenshots (untracked capture artifacts)
gui-test-screenshots/

# Browser-automation session cache
.playwright-cli/

# Accessibility-tree dump captured while debugging the demo UI
home.yaml

# One-off repair script kept while migrating the demo app
demo-app/.tmp-repair.py

# Video footage captured for the submission video (lives in YouTube, not git)
demo-video-footage/

# Ad-hoc UI screenshots taken while building the offer flow
ui-*.png

# Windows shell redirect artifact ("... > nul" in a POSIX-style shell)
demo-app/nul
nul
