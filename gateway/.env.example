# litellm/.env.example
#
# Copy to .env and fill in. NEVER commit the real .env.

# --- Master key for the LiteLLM proxy admin API ---
LITELLM_MASTER_KEY=sk-litellm-master-CHANGE-ME-IN-PROD

# --- Database / Redis (matches docker-compose.yml) ---
DATABASE_URL=postgresql://litellm:litellm_dev_only@localhost:5434/litellm
REDIS_HOST=localhost
REDIS_PORT=6381
REDIS_PASSWORD=litellm_dev_only

# --- Provider keys (BYO real test keys from each provider's test mode) ---
OPENAI_API_KEY_A=sk-...
OPENAI_API_KEY_B=sk-...
OPENAI_API_KEY_C=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=AIza...
GROQ_API_KEY=gsk-...

# --- Autumn bridge ---
# The Autumn server mounts its balances API under /v1 (apiRouter in initHono.ts).
AUTUMN_BASE_URL=http://localhost:8080/v1
AUTUMN_API_KEY=am_sk_REPLACE_ME
AUTUMN_FEATURE_ID=ai_tokens
AUTUMN_CUSTOMER_HEADER=user
AUTUMN_ADMIT_MODE=block
AUTUMN_CHECK_TTL_SEC=1.0
AUTUMN_TIMEOUT_SEC=2.0
AUTUMN_FAIL_MODE=open
AUTUMN_USE_LOCK=false

# Minimum balance /check demands before a call may start (Autumn default 1.0).
AUTUMN_REQUIRED_BALANCE=1.0

# Map LiteLLM model names/aliases to Autumn-billable ids.  Autumn prices by
# exact "<provider>/<model>" against models.dev, or "custom/<name>" against
# the feature's model_markups.  Matched on the full id, then the bare name.
# AUTUMN_MODEL_ID_MAP={"my-alias":"custom/my-model"}