# gateway/.env.example
#
# Copy to .env and fill in. NEVER commit the real .env.

# --- Master key for the LiteLLM proxy admin API ---
LITELLM_MASTER_KEY=sk-litellm-master-CHANGE-ME-IN-PROD

# --- Database / Redis (matches docker-compose.yml) ---
DATABASE_URL=postgresql://litellm:litellm_dev_only@localhost:5434/litellm
REDIS_HOST=localhost
REDIS_PORT=6381
REDIS_PASSWORD=litellm_dev_only

# --- Provider keys (BYO real test keys from each provider's test mode) ---
OPENAI_API_KEY_A=sk-...
OPENAI_API_KEY_B=sk-...
OPENAI_API_KEY_C=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=AIza...
GROQ_API_KEY=gsk-...

# --- MeterPal billing bridge ---
# The billing server mounts its API under /v1 (apiRouter in initHono.ts).
# Legacy AUTUMN_* names are still honored as fallbacks.
PAB_BASE_URL=http://localhost:8080/v1
PAB_API_KEY=am_sk_REPLACE_ME
PAB_FEATURE_ID=ai_tokens
PAB_CUSTOMER_HEADER=user
PAB_ADMIT_MODE=block
PAB_CHECK_TTL_SEC=1.0
PAB_TIMEOUT_SEC=2.0
PAB_FAIL_MODE=open
PAB_USE_LOCK=false

# Minimum balance /check demands before a call may start (server default 1.0).
PAB_REQUIRED_BALANCE=1.0

# Map LiteLLM model names/aliases to billable ids.  The billing server prices
# by exact "<provider>/<model>" against models.dev, or "custom/<name>" against
# the feature's model_markups.  Matched on the full id, then the bare name.
# PAB_MODEL_ID_MAP={"my-alias":"custom/my-model"}
# Runtime model management: lets the billing server add/delete model
# deployments at runtime (POST /model/new, /model/delete). Models are
# persisted to the Prisma DB and survive restarts.
# STORE_MODEL_IN_DB=True
