# gateway/.env.example
#
# Copy to .env and fill in. NEVER commit the real .env.

# --- Master key for the LiteLLM proxy admin API ---
LITELLM_MASTER_KEY=sk-litellm-master-CHANGE-ME-IN-PROD

# --- Database / Redis (matches docker-compose.yml) ---
DATABASE_URL=postgresql://litellm:litellm_dev_only@localhost:5434/litellm
REDIS_HOST=localhost
REDIS_PORT=6381
REDIS_PASSWORD=litellm_dev_only

# --- Provider keys (BYO real test keys from each provider's test mode) ---
OPENAI_API_KEY_A=sk-...
OPENAI_API_KEY_B=sk-...
OPENAI_API_KEY_C=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=AIza...
GROQ_API_KEY=gsk-...

# --- MeterPal billing bridge ---
# The billing server mounts its API under /v1 (apiRouter in initHono.ts).
# Legacy AUTUMN_* names are still honored as fallbacks.
PAB_BASE_URL=http://localhost:8080/v1
PAB_API_KEY=am_sk_REPLACE_ME
PAB_FEATURE_ID=ai_tokens
PAB_CUSTOMER_HEADER=user
PAB_ADMIT_MODE=block
PAB_TIMEOUT_SEC=2.0
PAB_FAIL_MODE=open

# The bearer the bridge presents to the billing server.  A shared-gateway
# deployment presents this trust secret and names the tenant it resolved
# from the caller's virtual key; PAB_API_KEY alone is the single-merchant form.
# Either one configures the bridge -- both missing disables it.
# PAB_TRUST_SECRET=change-me-shared-gateway-secret

# The reservation bounds concurrent spend: without a hold, N concurrent
# requests each see the whole balance and every one of them is admitted.
PAB_USE_LOCK=true
# Refuse a request the billing server admitted without a reservation.
PAB_REQUIRE_LOCK=true

# Minimum balance /check demands before a call may start (server default 1.0).
PAB_REQUIRED_BALANCE=1.0

# Output ceiling for a request that does not cap its own output; also the
# worst-case estimate the reservation is sized from.
# PAB_MAX_OUTPUT_TOKENS=8192

# How long a reservation may live before the billing server releases it.
# PAB_LOCK_TTL_SEC=900

# Which MeterPal environment the charges land in.
# PAB_ENV=sandbox

# Per-org ceilings: one merchant cannot exhaust the shared provider quota.
# PAB_ORG_RPM_LIMIT=600
# PAB_ORG_TPM_LIMIT=4000000

# Map LiteLLM model names/aliases to billable ids.  The billing server prices
# by exact "<provider>/<model>" against models.dev, or "custom/<name>" against
# the feature's model_markups.  Matched on the full id, then the bare name.
# PAB_MODEL_ID_MAP={"my-alias":"custom/my-model"}
# Runtime model management: lets the billing server add/delete model
# deployments at runtime (POST /model/new, /model/delete). Models are
# persisted to the Prisma DB and survive restarts.
# STORE_MODEL_IN_DB=True
